# Cargo build output, including standalone packages such as fuzz/.
target/
bindings/node/node_modules/
bindings/node/*.node
bindings/python/.venv/
bindings/python/dist/
bindings/python/python/cellrune/*.so
bindings/python/python/cellrune/*.pyd
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Runtime state generated by cargo-fuzz. Fuzz targets and manifests stay tracked.
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/coverage/

*.profraw
*.tgz
*.whl
.DS_Store

# Credential stores. Registry and network tooling writes these into the working
# tree, so they are ignored to keep them from ever reaching a commit.
.env
.git-credentials
.netrc
_netrc
.npmrc
.pypirc
*.jks
*.key
*.p12
*.pem
*.pfx
